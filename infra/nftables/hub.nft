table inet vila {
	set iot {
		type ipv4_addr
		flags interval
		elements = { 10.99.0.11-10.99.0.15 }
	}

	chain input {
		type filter hook input priority filter; policy drop;
		iif "lo" accept
		ip daddr { 10.250.1.10, 10.250.2.10 } icmp type echo-request limit rate 5/second burst 10 packets counter accept comment "internet -> ping limitado (teste de link das bordas)"
		ip daddr { 10.250.1.10, 10.250.2.10 } icmp type echo-request counter drop comment "ping acima do limite"
		ct state established,related accept
		ct state invalid drop
		ip daddr { 10.250.1.10, 10.250.2.10 } udp dport 51820 counter accept comment "internet -> wireguard"
		iifname "wg0" ip saddr @iot tcp dport 8443 counter accept comment "iot -> ingestao"
		iifname "wg0" ip saddr @iot udp dport 123 counter accept comment "iot -> ntp"
		iifname "wg0" icmp type echo-request counter accept comment "tunel -> ping do hub"
		counter comment "entrada negada"
	}

	chain forward {
		type filter hook forward priority filter; policy drop;
		ct state established,related accept
		ct state invalid drop
		iifname "wg0" ip saddr 10.99.0.100 ip daddr 10.30.3.10 tcp dport 22 counter accept comment "admin vpn -> bastion ssh"
		ip saddr 10.30.3.10 ip daddr 10.30.1.20 tcp dport 5432 counter accept comment "bastion -> banco"
		ip saddr { 10.30.2.20, 10.30.2.21 } ip daddr 10.30.1.20 tcp dport 5432 counter accept comment "painel (ops) -> banco (svc)"
		counter comment "trafego entre zonas negado"
	}

	chain postrouting {
		type nat hook postrouting priority srcnat; policy accept;
		ip daddr 10.30.1.0/24 ip saddr != 10.30.1.0/24 masquerade
	}
}
